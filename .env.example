IDP_INPUT_DIR=./data/input
IDP_OUTPUT_DIR=./output
IDP_MODEL_NAME=gpt-4o-mini
IDP_TEMPERATURE=0.1
# Ruta al ejecutable de Tesseract OCR en Windows.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Carpeta bin de Poppler para convertir PDFs escaneados en imágenes.
POPPLER_PATH=C:\poppler-26.09.0\Library\bin
